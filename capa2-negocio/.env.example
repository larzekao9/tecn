APP_NAME="Canal 11"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/La_Paz

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Base de datos ---
# Docker (docker compose) ya define estas variables. Para el servidor del curso use:
#   DB_HOST=db.tecnoweb.org.bo  DB_DATABASE=db_grupo12sa  DB_USERNAME=grupo12sa  DB_PASSWORD=...
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=canal11
DB_USERNAME=canal11
DB_PASSWORD=canal11
# Las tablas del sistema viven en este esquema (separadas de otras tablas de la base)
DB_SCHEMA=canal11

SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# --- Frontend (CORS) ---
FRONTEND_URL=http://localhost:5173

# --- Correo (opcional): los avisos siempre quedan en la web; con NOTIFICACIONES_CORREO=true tambien salen por correo ---
NOTIFICACIONES_CORREO=false
MAIL_MAILER=log
MAIL_HOST=mail.tecnoweb.org.bo
MAIL_PORT=25
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="grupo12sa@tecnoweb.org.bo"
MAIL_FROM_NAME="Canal 11"

# --- Alertas automaticas ---
ALERTA_PARRILLA_HORAS=24
ALERTA_PARRILLA_URGENTE_HORAS=6
ALERTA_EMISION_MINUTOS=30
ALERTA_EMISION_VENTANA_HORAS=48

# --- Seguridad del login ---
LOGIN_TOKEN_HORAS=12

# Solo demostraciones: hora fija del sistema (ej. 2026-11-20T10:00). Vacio = hora real.
CANAL11_AHORA=

# Administradores iniciales: CI,Nombre,Apellido,correo,contrasena ; separados por punto y coma
ADMINISTRADORES=
# Encargados de Contenidos que se crean al iniciar. Formato: CI,Nombre,Apellido,correo,contrasena ; separados por punto y coma
CUENTAS_ENCARGADO=
# Contrasena de las cuentas de demostracion
DEMO_PASSWORD=
# Pautas: simbolo de la moneda y maximo de cuotas de un plan de pago (el precio por segundo es de cada espacio publicitario)
MONEDA_SIMBOLO=
MAX_CUOTAS=
# Cuentas de anunciante iniciales: CI,Nombre,Apellido,correo,contrasena ; separadas por punto y coma
CUENTAS_ANUNCIANTE=

# --- CU6 Pago del anunciante en Stripe: tarjeta o QR (modo de prueba) ---
STRIPE_SECRET=
STRIPE_MONEDA=bob
# Pago por QR: Cash App Pay de Stripe (solo en dolares); TIPO_CAMBIO = bolivianos por 1 dolar
STRIPE_QR_METODO=cashapp
STRIPE_QR_MONEDA=usd
TIPO_CAMBIO=
PAGO_MINIMO=
STRIPE_MINUTOS=31
